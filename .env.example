# SoulSpace server configuration. Keep secrets on the server, never in the app.
#
# LIVE AI, FREE OPTION (recommended): Groq free tier, no credit card.
# 1. Create a free account at https://console.groq.com and create an API key.
# 2. Set GROQ_API_KEY below. AI_PROVIDER defaults to groq when the key is set.
# 3. GROQ_MODEL defaults to openai/gpt-oss-120b. Published free-tier limits
#    (Nov 2026, verify at https://console.groq.com/docs/rate-limits before
#    launch): 30 requests/minute, 1,000 requests/day, 200,000 tokens/day,
#    shared across all users of the key. The server's per-user daily limits
#    (20/day on the free plan) sit underneath that shared cap; when Groq
#    rate-limits, the app honestly reports the companion as busy.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b (used once if the primary model is rate-limited; set empty to disable)
#
# ALTERNATIVE, ALSO FREE (tighter limits): OpenRouter free models.
# Set OPENROUTER_API_KEY and OPENROUTER_MODEL (a model ID ending in :free,
# e.g. see https://openrouter.ai/models?max_price=0). Free-model rate limits
# are much lower than Groq's and the roster changes often; verify before use.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
#
# PAID OPTION: Anthropic. Set both values; AI_PROVIDER=anthropic forces it
# even when a Groq key is also present.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
#
# AI_PROVIDER=groq
# AI_BASE_URL=  (advanced/testing only: override the chat-completions endpoint)
PORT=8787
# Optional: set an absolute path for persistent SQLite storage.
# DB_FILE=/data/soulspace.db
# Optional allowed native app origins (comma-separated); do not use '*'.
CORS_ORIGINS=capacitor://localhost,https://localhost,http://localhost,ionic://localhost
# Only set true when the app is behind a reverse proxy that you control and trust.
TRUST_PROXY=false
